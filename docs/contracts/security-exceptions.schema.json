{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "exceptions"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "exceptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "ecosystem",
          "package",
          "versions",
          "scope",
          "owner",
          "rationale",
          "compensating_control",
          "issue",
          "expires"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "ecosystem": {
            "enum": [
              "npm",
              "rust"
            ]
          },
          "package": {
            "type": "string",
            "minLength": 1
          },
          "versions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "scope": {
            "enum": [
              "development-only",
              "uncompiled-optional",
              "unmaintained-macro"
            ]
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "compensating_control": {
            "type": "string",
            "minLength": 1
          },
          "issue": {
            "type": "string",
            "pattern": "^https://github.com/mohripan/capsulet/issues/[0-9]+$"
          },
          "expires": {
            "type": "string",
            "format": "date"
          }
        }
      }
    }
  }
}
