{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://capsulet.dev/contracts/test-manifest.schema.json",
  "title": "Capsulet collected claim evidence",
  "description": "Generated by capsulet-xtask claims collect from what each gate command collects. Do not edit.",
  "type": "object",
  "required": ["schema_version", "generated_by", "commands"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "generated_by": { "type": "string", "minLength": 1 },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["gate", "command", "tests"],
        "additionalProperties": false,
        "properties": {
          "gate": { "type": "string", "minLength": 1 },
          "command": { "type": "string", "minLength": 1 },
          "tests": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["path", "selector"],
              "additionalProperties": false,
              "properties": {
                "path": { "type": "string", "minLength": 1 },
                "selector": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    }
  }
}
