{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://capsulet.dev/contracts/product-claims.schema.json",
  "title": "Capsulet product claim registry",
  "type": "object",
  "required": ["schema_version", "public_surfaces", "claims"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "public_surfaces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "category", "marker_required"],
        "additionalProperties": false,
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "category": {
            "enum": ["root-docs", "product-docs", "operations", "security", "sdk", "dashboard", "example", "package-metadata", "served-openapi"]
          },
          "marker_required": { "type": "boolean" }
        }
      }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "kind", "maturity", "area", "statement", "public_surfaces", "evidence"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^CAP-[A-Z][A-Z0-9-]*-[0-9]{3}$" },
          "kind": { "enum": ["positioning", "capability", "guarantee", "limitation", "compatibility"] },
          "maturity": { "enum": ["implemented", "experimental", "planned"] },
          "area": { "type": "string", "minLength": 1 },
          "statement": { "type": "string", "minLength": 1 },
          "public_surfaces": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["type", "path"],
              "additionalProperties": false,
              "properties": {
                "type": { "enum": ["decision", "specification", "source", "test"] },
                "path": { "type": "string", "minLength": 1 },
                "command": { "type": "string", "minLength": 1 },
                "selector": { "type": "string", "minLength": 1 }
              },
              "allOf": [
                {
                  "if": { "properties": { "type": { "const": "test" } } },
                  "then": { "required": ["command", "selector"] }
                }
              ]
            }
          }
        }
      }
    }
  }
}
